{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --include=dev",
  "crons": [
    {
      "path": "/api/internal/cron/cleanup-challenges",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}

