# Server environment template — copy to server/.env and fill in values

NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=

# Frontend
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# MSG91 (email + SMS OTP)
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_FROM_EMAIL=
MSG91_FROM_NAME=HOSCORE
MSG91_TEMPLATE_ID=
MSG91_EMAIL_TEMPLATE_ID=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN_AUTH=

# Scheduled jobs (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
